{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofpath.example/schemas/proofpath-github-evidence-collector-config-v0.1.schema.json",
  "title": "ProofPath GitHub Evidence Collector Config v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "artifact_job_name",
    "authority",
    "security",
    "approval_role_map",
    "check_app_allowlist",
    "change_ticket"
  ],
  "properties": {
    "profile_id": {
      "const": "proofpath.github.evidence-collector-config.v0.1"
    },
    "artifact_job_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "expires_at", "scope"],
      "properties": {
        "active": {"type": "boolean"},
        "expires_at": {"type": "string", "format": "date-time"},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositories", "environments", "actions"],
          "properties": {
            "repositories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "environments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_vulnerabilities"],
      "properties": {
        "critical_vulnerabilities": {"type": "integer", "minimum": 0}
      }
    },
    "approval_role_map": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_.-]{1,100}$"},
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000\\r\\n]+$"
      }
    },
    "check_app_allowlist": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000\\r\\n]+$"
      }
    },
    "change_ticket": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "status", "commit_sha"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "status": {"type": "string", "minLength": 1},
            "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
          }
        }
      ]
    }
  }
}
