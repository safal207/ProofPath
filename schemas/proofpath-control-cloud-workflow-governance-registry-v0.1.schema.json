{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofpath.dev/schemas/proofpath-control-cloud-workflow-governance-registry-v0.1.schema.json",
  "title": "ProofPath Workflow Governance Registry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "generated_at", "records", "revocations"],
  "properties": {
    "profile_id": {"const": "proofpath.control-cloud.workflow-governance-registry.v0.1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "status", "repository", "owner_scope", "workflow", "signer_sha", "workflow_file_digest", "allowed_event_types", "allowed_ref_prefixes", "reviewer_quorum", "effective_at", "expires_at", "review_ticket", "authority_granted"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "status": {"enum": ["ACTIVE", "SUSPENDED", "REVOKED"]},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "owner_scope": {"type": "string", "minLength": 1},
          "workflow": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"},
          "signer_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "workflow_file_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "allowed_event_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_ref_prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reviewer_quorum": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "reviewers", "approvals"],
            "properties": {
              "required": {"type": "integer", "minimum": 1},
              "reviewers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "approvals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "effective_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "review_ticket": {"type": "string", "minLength": 1},
          "authority_granted": {"const": false}
        }
      }
    },
    "revocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revocation_id", "record_id", "effective_at", "reason_code", "approved_by", "authority_granted"],
        "properties": {
          "revocation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "effective_at": {"type": "string", "format": "date-time"},
          "reason_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "approved_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "authority_granted": {"const": false}
        }
      }
    }
  }
}
