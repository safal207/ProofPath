{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofpath.dev/schemas/proofpath-control-cloud-workflow-governance-decision-v0.1.schema.json",
  "title": "ProofPath Workflow Governance Decision v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "decision", "reason_code", "governance_trust_verified", "observed_at", "repository", "signer_repository", "signer_workflow", "signer_sha", "workflow_file_digest", "event_type", "ref", "admission_result_root", "subject_digest", "trust_record_id", "trust_record_root", "reviewer_quorum_verified", "trust_window_verified", "revocation_checked", "owner_scope_verified", "authority_granted", "repository_write_performed", "deployment_performed", "payments_executed", "decision_root"],
  "properties": {
    "profile_id": {"const": "proofpath.control-cloud.workflow-governance-decision.v0.1"},
    "decision": {"enum": ["ACCEPT", "HOLD", "BLOCK", "CHALLENGE"]},
    "reason_code": {"type": ["string", "null"]},
    "governance_trust_verified": {"type": "boolean"},
    "observed_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "signer_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "signer_workflow": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"},
    "signer_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workflow_file_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_type": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "admission_result_root": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "trust_record_id": {"type": ["string", "null"]},
    "trust_record_root": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewer_quorum_verified": {"type": "boolean"},
    "trust_window_verified": {"type": "boolean"},
    "revocation_checked": {"type": "boolean"},
    "owner_scope_verified": {"type": "boolean"},
    "authority_granted": {"const": false},
    "repository_write_performed": {"const": false},
    "deployment_performed": {"const": false},
    "payments_executed": {"const": false},
    "decision_root": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
