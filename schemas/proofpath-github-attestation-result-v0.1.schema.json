{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofpath.example/schemas/proofpath-github-attestation-result-v0.1.schema.json",
  "title": "ProofPath GitHub Attestation Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "verified",
    "source_sha",
    "artifact_digest",
    "workflow",
    "signer_sha",
    "runner_environment"
  ],
  "properties": {
    "profile_id": {"const": "proofpath.github.attestation-result.v0.1"},
    "verified": {"type": "boolean"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workflow": {"type": "string", "minLength": 1},
    "signer_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "runner_environment": {"enum": ["github-hosted", "self-hosted", "unknown"]}
  }
}
