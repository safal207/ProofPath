{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofpath.example/schemas/proofpath-github-approval-role-map-v0.1.schema.json",
  "title": "ProofPath GitHub Approval Role Map v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "actors"],
  "properties": {
    "profile_id": {"const": "proofpath.github.approval-role-map.v0.1"},
    "actors": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_.-]{1,100}$"},
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9_. /:@+()\\[\\]-]{1,200}$"}
    }
  }
}
