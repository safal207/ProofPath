{
  "$id": "https://proofpath.dev/schemas/proofpath-control-cloud-ingest-receipt-v0.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {"type": "string"},
    "authority_granted": {"const": false},
    "content_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "decision": {"enum": ["ACCEPT", "HOLD", "BLOCK", "CHALLENGE"]},
    "deployment_performed": {"const": false},
    "event_index": {"minimum": 1, "type": "integer"},
    "event_root": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "financial_status": {"const": "RECORDED_NOT_PAYABLE"},
    "insurance_provided": {"const": false},
    "payments_executed": {"const": false},
    "previous_event_root": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "profile_id": {"const": "proofpath.control-cloud.ingest-receipt.v0.1"},
    "provenance_cryptographically_verified_by_api": {"const": false},
    "receipt_root": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "request_id": {"type": "string"},
    "status": {"const": "ACCEPTED"},
    "stored_at": {"type": "string"},
    "tenant_id": {"type": "string"}
  },
  "required": [
    "profile_id",
    "status",
    "tenant_id",
    "request_id",
    "action_id",
    "decision",
    "content_digest",
    "event_index",
    "previous_event_root",
    "event_root",
    "stored_at",
    "receipt_root",
    "financial_status",
    "payments_executed",
    "insurance_provided",
    "deployment_performed",
    "authority_granted",
    "provenance_cryptographically_verified_by_api"
  ],
  "title": "ProofPath Control Cloud Ingest Receipt v0.1",
  "type": "object"
}
