{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "minLength": 1,
      "type": "string"
    },
    "admission_result_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "admitted_event_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "approval_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "authority_granted": {
      "const": false,
      "type": "boolean"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "decision": {
      "minLength": 1,
      "type": "string"
    },
    "deployment_performed": {
      "const": false,
      "type": "boolean"
    },
    "financial_status": {
      "const": "RECORDED_NOT_PAYABLE"
    },
    "governance_decision_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "governance_trust_verified_by_api": {
      "const": true,
      "type": "boolean"
    },
    "governed_receipt_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "identity_registry_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "insurance_provided": {
      "const": false,
      "type": "boolean"
    },
    "payments_executed": {
      "const": false,
      "type": "boolean"
    },
    "profile_id": {
      "const": "proofpath.control-cloud.separated-ingest-receipt.v0.1"
    },
    "provenance_cryptographically_verified_by_api": {
      "const": true,
      "type": "boolean"
    },
    "receipt_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "repository_write_performed": {
      "const": false,
      "type": "boolean"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "reviewer_identity_verified_by_api": {
      "const": true,
      "type": "boolean"
    },
    "reviewer_separation_decision_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "separation_of_duties_verified_by_api": {
      "const": true,
      "type": "boolean"
    },
    "status": {
      "const": "ACCEPTED_WITH_PROVENANCE_GOVERNANCE_AND_REVIEWER_SEPARATION"
    },
    "stored_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "subject_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "type": "string"
    },
    "trust_record_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "verified_organization_count": {
      "minimum": 1,
      "type": "integer"
    },
    "verified_reviewer_count": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "profile_id",
    "status",
    "tenant_id",
    "request_id",
    "action_id",
    "decision",
    "content_digest",
    "admitted_event_root",
    "admission_result_root",
    "governance_decision_root",
    "reviewer_separation_decision_root",
    "trust_record_root",
    "identity_registry_digest",
    "approval_bundle_digest",
    "verified_reviewer_count",
    "verified_organization_count",
    "subject_digest",
    "stored_at",
    "governed_receipt_root",
    "provenance_cryptographically_verified_by_api",
    "governance_trust_verified_by_api",
    "reviewer_identity_verified_by_api",
    "separation_of_duties_verified_by_api",
    "financial_status",
    "payments_executed",
    "insurance_provided",
    "deployment_performed",
    "authority_granted",
    "repository_write_performed",
    "receipt_root"
  ],
  "type": "object"
}
