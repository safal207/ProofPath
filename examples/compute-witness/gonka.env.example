# Required: OpenAI-compatible Gonka broker endpoint and credentials.
# Do not commit real secrets.
GONKA_BASE_URL=https://your-gonka-broker.example/v1
GONKA_API_KEY=replace-me
GONKA_MODEL=replace-with-supported-model

# Conservative defaults for the pilot.
GONKA_REPLICAS=3
GONKA_TIMEOUT_SECONDS=30
GONKA_AGREEMENT_THRESHOLD=0.85

# Optional fallback. Configure all three values or none.
# GONKA_FALLBACK_BASE_URL=https://fallback-provider.example/v1
# GONKA_FALLBACK_API_KEY=replace-me
# GONKA_FALLBACK_MODEL=replace-with-fallback-model
