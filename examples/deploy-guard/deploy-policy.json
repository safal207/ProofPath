{
  "profile_id": "proofpath.deploy.guard-policy.v0.1",
  "policy_id": "production-deploy-standard",
  "policy_version": "1.0.0",
  "allowed_repositories": [
    "safal207/ProofPath"
  ],
  "allowed_environments": [
    "production"
  ],
